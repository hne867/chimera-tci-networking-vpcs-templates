{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Networking VPC Config",
  "type": "object",
  "required": ["deployment", "vrfDetails"],
  "properties": {
    "deployment": {
      "type": "object",
      "required": ["org", "environment", "name"],
      "properties": {
        "org": { "type": "string" },
        "environment": { "type": "string" },
        "name": { "type": "string" },
        "id": { "type": "string" }
      }
    },
    "vrfDetails": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["vrfName", "region", "ipam"],
        "properties": {
          "vrfName": { "type": "string" },
          "region": { "type": "string" },
          "routingRef": { "type": "string" },
          "ipam": {
            "type": "object",
            "required": ["primaryCidr"],
            "properties": {
              "primaryCidr": { "type": "string" },
              "additionalCidrs": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "transitGateway": {
            "type": "object",
            "properties": {
              "id": { "type": "string" }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
