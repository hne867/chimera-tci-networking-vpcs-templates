{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Networking VPC Repo Config",
  "type": "object",
  "required": ["routing", "vrf"],
  "additionalProperties": false,
  "properties": {
    "routing": {
      "type": "object",
      "required": ["ipam"],
      "additionalProperties": false,
      "properties": {
        "ipam": {
          "type": "object",
          "required": ["primary_cidr"],
          "additionalProperties": false,
          "properties": {
            "primary_cidr": { "type": "string" },
            "additional_cidrs": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "transit_gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" }
          }
        }
      },
      "required": ["ipam", "transit_gateway"]
    },
    "vrf": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "isolated": { "type": "boolean" }
      }
    }
  }
}
